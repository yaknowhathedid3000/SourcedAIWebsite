// Build settings surfaced into Info.plist (see project.yml -> info.properties)
// and into signing. Copy this file to Yogi.local.xcconfig for your own values;
// that copy is git-ignored and is #include?'d at the bottom.
//
// Values live here rather than in Xcode's UI because `xcodegen generate`
// rewrites the project and would throw UI changes away every time.
//
// The $() in the URL is required: xcconfig treats // as a comment marker.

SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR_PUBLISHABLE_KEY

// Your 10-character Apple Developer Team ID (Membership tab in the portal).
// Set it in Yogi.local.xcconfig and both targets sign without touching Xcode.
DEVELOPMENT_TEAM =

#include? "Yogi.local.xcconfig"
